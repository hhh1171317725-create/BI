{
  "manifest_version": 3,
  "name": "投放工具助手",
  "version": "1.9.2",
  "description": "支持京东商品主图下载、Adpflux 广告创建、素材账户选择和充值账户查询。",
  "permissions": ["activeTab", "downloads", "scripting", "tabs", "alarms", "storage", "cookies"],
  "host_permissions": [
    "https://item.jd.com/*",
    "https://*.360buyimg.com/*",
    "https://huanghaha.fun/*",
    "https://www.huanghaha.fun/*",
    "https://www.adpflux.com/*",
    "https://ad.hubxad.com/*",
    "https://cl.mobgi.com/*",
    "https://cli1.mobgi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://item.jd.com/*.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://huanghaha.fun/*", "https://www.huanghaha.fun/*"],
      "js": ["bridge.js", "bid-sync-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.adpflux.com/ad-manage/batch-create*"],
      "css": ["adpflux.css"],
      "js": ["adpflux.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.adpflux.com/material-library*"],
      "js": ["material-library.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.adpflux.com/iframe/account-manage*"],
      "js": ["account-manage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ad.hubxad.com/*"],
      "js": ["recharge-frame.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "投放工具助手",
    "default_popup": "popup.html"
  }
}
