[Unit]
Description=Dahanghai analysis dashboard
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/BI
Environment=DHH_HOST=127.0.0.1
Environment=DHH_PORT=8765
Environment=DHH_OPEN_BROWSER=0
ExecStart=/usr/bin/python3 /www/wwwroot/BI/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
