    "/api/garmin-external/activities": {
      "get": {
        "operationId": "listGarminCachedActivities",
        "summary": "List cached activity headers for one day. Follow nextOffset until null. Does not trigger collection.",
        "description": "List cached activity headers for one day. Follow nextOffset until null. Does not trigger collection.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Cached date in Beijing.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based paging offset.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of activity headers per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached private health data. Missing metrics are null, never assumed zero.",
