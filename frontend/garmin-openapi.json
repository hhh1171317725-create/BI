{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Garmin Cached Health API",
    "version": "1.0.0",
    "description": "Read-only private health records, authorized by an expiring personal Bearer key. Never triggers Garmin login or collection. null is missing, not zero. All dates use Asia/Shanghai. Respect responseLimited and missingDates."
  },
  "servers": [
    {
      "url": "https://www.huanghaha.fun"
    }
  ],
  "security": [
    {
      "GarminReadKey": []
    }
  ],
  "paths": {
    "/api/garmin-external/status": {
      "get": {
        "operationId": "getGarminCacheStatus",
        "summary": "Check cached health data freshness and Beijing current date. Does not log in or sync Garmin.",
        "description": "Check cached health data freshness and Beijing current date. Does not log in or sync Garmin.",
        "x-openai-isConsequential": false,
        "parameters": [],
        "responses": {
          "200": {
            "description": "Cached private health data. Missing metrics are null, never assumed zero.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Invalid dates, categories or paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked Bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Website account inactive or Garmin tool permission removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No cached record; sync on website first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "60 requests per minute; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Cache unavailable; retry later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/garmin-external/data": {
      "get": {
        "operationId": "getGarminDailySummaries",
        "summary": "Read up to 31 inclusive days of cached daily summaries. Defaults to the last 7 days. Activities and raw details use separate operations.",
        "description": "Read up to 31 inclusive days of cached daily summaries. Defaults to the last 7 days. Activities and raw details use separate operations.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "description": "First day, inclusive. Defaults to six days before endDate.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Last day, inclusive. Defaults to today in Beijing. Future dates are rejected.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
