        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Cached date in Beijing.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Daily detail code. Request a specific code to reduce omitted data.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "daily",
                "sleep",
                "heart",
                "hrv",
                "weight",
                "battery",
                "steps",
                "floors",
                "stress",
                "battery_events",
                "hydration",
