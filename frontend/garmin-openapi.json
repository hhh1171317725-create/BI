                "menstrual",
                "nutrition",
                "meals",
                "composition",
                "blood_pressure",
                "race_predictions",
                "running_tolerance",
                "ftp",
                "lactate_threshold"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached private health data. Missing metrics are null, never assumed zero.",
