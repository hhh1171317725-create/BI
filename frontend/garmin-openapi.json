    "/api/garmin-external/activity": {
      "get": {
        "operationId": "getGarminActivityDetails",
        "summary": "Read one cached activity belonging to this account and date. Samples are compacted and omitted by default. Use category to read a specific detail.",
        "description": "Read one cached activity belonging to this account and date. Samples are compacted and omitted by default. Use category to read a specific detail.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Cached date in Beijing.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "activityId",
            "in": "query",
            "description": "ID returned by listGarminCachedActivities; never infer it.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,29}$"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Activity detail code. category=samples explicitly requests compact samples.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "overview",
                "splits",
                "typed_splits",
                "split_summaries",
                "weather",
                "heart_zones",
                "power_zones",
                "exercise_sets",
                "gear",
                "samples"
              ],
              "default": "all"
            }
          },
          {
            "name": "includeSamples",
            "in": "query",
            "description": "Include compact samples when category=all. Arrays still limited to 30 items.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached private health data. Missing metrics are null, never assumed zero.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid dates, categories or paging parameters",
            "content": {
              "application/json": {
