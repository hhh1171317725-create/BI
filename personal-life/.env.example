# Copy to .env and fill every CHANGE_ME field. No default credentials.
APP_ORIGIN=https://health.example.com
WEB_PORT=3100
POSTGRES_DB=personal_life
POSTGRES_USER=life_app
POSTGRES_PASSWORD=CHANGE_ME_random_url_safe_secret
DATABASE_URL=postgresql://life_app:CHANGE_ME_random_url_safe_secret@postgres:5432/personal_life
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=CHANGE_ME_at_least_14_characters
INGEST_API_KEY=CHANGE_ME_generate_32_random_bytes
# Internal testing contract only, NOT HAE. Hozz JSON v1 does not need this flag.
ALLOW_NORMALIZED_INGEST=false
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_INGEST_BYTES=5242880
# Enable only on a separate local test/dev server.
ALLOW_INSECURE_LOCAL=false
